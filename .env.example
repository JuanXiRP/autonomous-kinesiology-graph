# Copy to .env and fill in your own values (never commit .env)

# Gemini API key (variant resolver, content and animation-spec generation)
GOOGLE_API_KEY=

# Supabase Postgres connection string
DATABASE_URL=

# Supabase project URL and key for Storage uploads
# (public buckets `exercise_videos` and `exercise_images` must exist)
SUPABASE_URL=
SUPABASE_KEY=
